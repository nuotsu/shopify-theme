{% unless settings.font_primary.system? and settings.font_mono.system? %}
  <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
{% endunless %}
{% unless settings.font_primary.system? %}
  {{ settings.font_primary | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
{% endunless %}
{% unless settings.font_mono.system? %}
  {{ settings.font_mono | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
{% endunless %}
