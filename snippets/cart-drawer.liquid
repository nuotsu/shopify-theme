<button
  class="relative action px-ch after:content-none md:text-sm"
  type="button"
  commandfor="cart-drawer"
  command="show-modal"
>
  <div class="*:size-lh">{{ 'icon-bag.svg' | inline_asset_content }}</div>
  <span class="max-md:hidden">Cart</span>
  <span data-cart-count>
    ({{- cart.item_count -}})
  </span>
</button>

<dialog
  id="cart-drawer"
  class="color-scheme-1 anim-fade-to-l fixed inset-y-0 right-0 m-0 ml-auto size-full max-w-lg min-h-svh bg-background pb-[env(safe-area-inset-bottom)] backdrop:transition-opacity backdrop:starting:opacity-0"
  closedby="any"
  data-section-id="{{ section_id }}"
>
  <div class="flex flex-col h-full">
    <header class="sticky top-0 z-1 bg-background flex items-center gap-4 justify-between p-4 border-b">
      <a href="{{ routes.cart_url }}" class="inline-flex gap-x-[.5em] py-1 font-technical uppercase">
        <div class="*:size-lh">{{ 'icon-bag.svg' | inline_asset_content }}</div>
        Cart
        <span data-cart-count class="{% unless cart.item_count > 0 %} hidden {% endunless %}">
          ({{ cart.item_count }})
        </span>
      </a>

      <button
        class="cursor-pointer"
        type="button"
        commandfor="cart-drawer"
        command="close"
        aria-label="Close cart"
      >
        {{ 'icon-close.svg' | inline_asset_content }}
      </button>
    </header>

    <div
      class="@container/cart p-4 has-data-cart-empty:my-auto"
      data-cart-lines
      data-section-id="{{ section_id }}"
    >
      {%- render 'cart' -%}
    </div>
  </div>
</dialog>
