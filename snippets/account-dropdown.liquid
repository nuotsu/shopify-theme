<details
  class="accordion md:dropdown {{ class }}"
  style="--anchor-name: --account-dropdown;"
  name="header-{{ section.id }}"
  data-hover-details
>
  <summary class="py-1 md:text-sm justify-start!">
    <div class="*:size-lh">{{ 'icon-person.svg' | inline_asset_content }}</div>
    <span class="font-technical uppercase md:hidden">Account</span>
    <span class="shrink-0 ml-auto md:hidden">{{ 'icon-chevron-down.svg' | inline_asset_content }}</span>
  </summary>

  <ul class="
    max-md:anim-fade-to-b px-4 py-[.5lh] max-md:py-0 max-md:border-l max-md:mb-4 md:border
    [&_a]:block [&_a]:py-1 [&_a]:hover:underline md:-ml-4
  ">
    {% if customer %}
      <li>{{ 'My Account' | link_to: routes.account_url }}</li>
      <li>{{ 'Logout' | link_to: routes.account_logout_url }}</li>
    {% else %}
      <li>{{ 'Login' | link_to: routes.account_login_url }}</li>
      <li>{{ 'Register' | link_to: routes.account_register_url }}</li>
    {% endif %}
  </ul>
</details>
