<style>
  @scope {
    :scope {
      --color-background: {{ section.settings.color_scheme.settings.background }};
      --color-foreground: {{ section.settings.color_scheme.settings.foreground }};
      --color-primary: {{ section.settings.color_scheme.settings.primary }};
      --color-primary-foreground: {{ section.settings.color_scheme.settings.primary_foreground }};
      --color-secondary: {{ section.settings.color_scheme.settings.secondary }};
      --color-secondary-foreground: {{ section.settings.color_scheme.settings.secondary_foreground }};
      --color-accent: {{ section.settings.color_scheme.settings.accent }};

      background-color: var(--color-background);
      color: var(--color-foreground);
    }
  }
</style>

{% content_for 'blocks' %}

{% schema %}
{
  "name": "Hero (backdrop)",
  "tag": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "blocks": [{ "type": "_hero-backdrop" }],
  "presets": [
    {
      "name": "Hero (backdrop)",
      "blocks": {
        "hero_backdrop": {
          "type": "_hero-backdrop",
          "name": "Hero",
          "settings": {
            "enable_scheduling": false
          },
          "blocks": {
            "richtext": {
              "type": "richtext",
              "name": "Richtext",
              "settings": {
                "content": "<h1>Heading 1</h1><p>Lorem ipsum dolor sit amet consectetur adipisicing elit.</p>"
              }
            },
            "button_list": {
              "type": "button-list",
              "name": "Button list",
              "blocks": {
                "button": {
                  "type": "_button"
                }
              },
              "block_order": [
                "button"
              ]
            }
          },
          "block_order": [
            "richtext",
            "button_list"
          ]
        }
      },
      "block_order": [
        "hero_backdrop"
      ]
    },
    {
      "name": "Collection hero",
      "settings": {},
      "blocks": {
        "hero_backdrop": {
          "type": "_hero-backdrop",
          "name": "Hero",
          "settings": {
            "content_width": 750,
            "horizontal_alignment": "center",
            "vertical_alignment": "center"
          },
          "blocks": {
            "richtext": {
              "type": "richtext",
              "name": "Richtext",
              "settings": {
                "content": "<h1>{{ closest.collection.title }}</h1>{{ closest.collection.description }}"
              },
              "blocks": {}
            }
          },
          "block_order": [
            "richtext"
          ]
        }
      },
      "block_order": [
        "hero_backdrop"
      ],
      "category": "Collection"
    }
  ]
}
{% endschema %}
